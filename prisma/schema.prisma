generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Branch {
  id         Int         @id @default(autoincrement())
  name       String
  isDefault  Boolean     @default(false)
  createdAt  DateTime    @default(now())
  warehouses Warehouse[]
}

model Warehouse {
  id            Int              @id @default(autoincrement())
  name          String
  branch        Branch           @relation(fields: [branchId], references: [id])
  branchId      Int
  isDefault     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  stocks        WarehouseStock[]
  requestsFrom  TransferRequest[] @relation("RequestFrom")
  requestsTo    TransferRequest[] @relation("RequestTo")
  transfersFrom Transfer[]       @relation("TransferFrom")
  transfersTo   Transfer[]       @relation("TransferTo")
}

model WarehouseStock {
  id           Int        @id @default(autoincrement())
  warehouse    Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  warehouseId  Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float      @default(0)

  @@unique([warehouseId, ingredientId])
}

model Supplier {
  id               Int                @id @default(autoincrement())
  name             String
  phone            String?
  address          String?
  createdAt        DateTime           @default(now())
  invoices         PurchaseInvoice[]
  purchaseRequests PurchaseRequest[]
}

model Ingredient {
  id                   Int                   @id @default(autoincrement())
  name                 String
  secondaryName        String?
  sku                  String?               @unique
  barcode              String?
  category             String?
  unit                 String
  storageUnit          String?
  conversionFactor     Float                 @default(1)
  costPerUnit          Float                 @default(0)
  currentStock         Float                 @default(0)
  minStockAlert        Float                 @default(0)
  reorderLevel         Float                 @default(0)
  maxStockAlert        Float                 @default(0)
  isArchived           Boolean               @default(false)
  createdAt            DateTime              @default(now())
  recipes              Recipe[]
  movements            StockMovement[]
  purchaseItems        PurchaseItem[]
  productionItems      ProductionItem[]
  requestItems         PurchaseRequestItem[]
  inventoryItems       InventoryCountItem[]
  warehouseStocks      WarehouseStock[]
  transferRequestItems TransferRequestItem[]
  transferItems        TransferItem[]
  priceHistory         PriceHistory[]
}

model PriceHistory {
  id           Int        @id @default(autoincrement())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientId Int
  price        Float
  date         DateTime   @default(now())
  note         String?
}

model Product {
  id         Int                @id @default(autoincrement())
  name       String
  price      Float
  category   String?
  isActive   Boolean            @default(true)
  imagePath  String?
  createdAt  DateTime           @default(now())
  recipes    Recipe[]
  sales      Sale[]
  promotions PromotionProduct[]
}

model Customer {
  id            Int           @id @default(autoincrement())
  name          String
  phone         String?
  email         String?
  birthDate     String?
  loyaltyPoints Int           @default(0)
  notes         String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  reservations  Reservation[]
  orders        PosOrder[]
  sales         Sale[]
}

model Reservation {
  id              Int       @id @default(autoincrement())
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerId      Int?
  table           Table?    @relation(fields: [tableId], references: [id])
  tableId         Int?
  guestName       String
  guestPhone      String?
  reservationDate DateTime
  partySize       Int       @default(2)
  status          String    @default("pending")
  notes           String?
  createdAt       DateTime  @default(now())
}

model Table {
  id           Int           @id @default(autoincrement())
  number       String
  capacity     Int           @default(4)
  zone         String?
  status       String        @default("available")
  note         String?
  createdAt    DateTime      @default(now())
  reservations Reservation[]
}

model Promotion {
  id            Int                @id @default(autoincrement())
  name          String
  discountType  String             @default("percentage")
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean            @default(true)
  applyToAll    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  products      PromotionProduct[]
}

model PromotionProduct {
  id          Int       @id @default(autoincrement())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int

  @@unique([promotionId, productId])
}

model Recipe {
  id           Int        @id @default(autoincrement())
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           Int        @id @default(autoincrement())
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
  type         String
  referenceId  Int?
  note         String?
  createdAt    DateTime   @default(now())
}

model PurchaseInvoice {
  id            Int            @id @default(autoincrement())
  supplier      Supplier?      @relation(fields: [supplierId], references: [id])
  supplierId    Int?
  invoiceNumber String?
  invoiceDate   DateTime
  subtotal      Float
  taxRate       Float          @default(0)
  taxAmount     Float          @default(0)
  total         Float
  notes         String?
  status        String         @default("confirmed")
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]
}

model PurchaseItem {
  id           Int             @id @default(autoincrement())
  invoice      PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    Int
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
  unitPrice    Float
  totalPrice   Float
}

model Sale {
  id         Int       @id @default(autoincrement())
  product    Product   @relation(fields: [productId], references: [id])
  productId  Int
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId Int?
  quantity   Float
  unitPrice  Float
  total      Float
  source     String    @default("manual")
  status     String    @default("confirmed")
  note       String?
  saleDate   DateTime  @default(now())
  createdAt  DateTime  @default(now())
}

model Production {
  id        Int              @id @default(autoincrement())
  note      String?
  date      DateTime         @default(now())
  createdAt DateTime         @default(now())
  items     ProductionItem[]
}

model ProductionItem {
  id           Int        @id @default(autoincrement())
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  productionId Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
  type         String
}

model PurchaseRequest {
  id          Int                   @id @default(autoincrement())
  supplier    Supplier?             @relation(fields: [supplierId], references: [id])
  supplierId  Int?
  status      String                @default("pending")
  notes       String?
  requestDate DateTime              @default(now())
  createdAt   DateTime              @default(now())
  items       PurchaseRequestItem[]
}

model PurchaseRequestItem {
  id           Int             @id @default(autoincrement())
  request      PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    Int
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
  notes        String?
}

model TransferRequest {
  id              Int                   @id @default(autoincrement())
  referenceNumber String                @unique
  fromWarehouse   Warehouse             @relation("RequestFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId Int
  toWarehouse     Warehouse             @relation("RequestTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   Int
  status          String                @default("pending")
  note            String?
  requestDate     DateTime              @default(now())
  createdAt       DateTime              @default(now())
  items           TransferRequestItem[]
  transfer        Transfer?
}

model TransferRequestItem {
  id           Int             @id @default(autoincrement())
  request      TransferRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId    Int
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
  notes        String?
}

model Transfer {
  id              Int           @id @default(autoincrement())
  referenceNumber String        @unique
  request         TransferRequest? @relation(fields: [requestId], references: [id])
  requestId       Int?          @unique
  fromWarehouse   Warehouse     @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  fromWarehouseId Int
  toWarehouse     Warehouse     @relation("TransferTo", fields: [toWarehouseId], references: [id])
  toWarehouseId   Int
  transferDate    DateTime      @default(now())
  note            String?
  createdAt       DateTime      @default(now())
  items           TransferItem[]
}

model TransferItem {
  id           Int        @id @default(autoincrement())
  transfer     Transfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  transferId   Int
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId Int
  quantity     Float
}

model InventoryCount {
  id              Int                  @id @default(autoincrement())
  referenceNumber String               @unique
  status          String               @default("draft")
  workDate        DateTime?
  note            String?
  createdAt       DateTime             @default(now())
  closedAt        DateTime?
  items           InventoryCountItem[]
}

model InventoryCountItem {
  id               Int            @id @default(autoincrement())
  inventoryCount   InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  inventoryCountId Int
  ingredient       Ingredient     @relation(fields: [ingredientId], references: [id])
  ingredientId     Int
  systemQuantity   Float
  actualQuantity   Float          @default(0)
}

model Role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  fullAccess  Boolean @default(false)
  permissions String  @default("[]")
  isSystem    Boolean @default(false)
}

model User {
  id        Int           @id @default(autoincrement())
  name      String
  pin       String
  role      String        @default("")
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  logs      ActivityLog[]
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  Int?
  details   String?
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}

model Expense {
  id            Int      @id @default(autoincrement())
  date          DateTime
  category      String   @default("other")
  type          String   @default("indirect")
  description   String
  amount        Float
  invoiceNumber String?
  vendor        String?
  notes         String?
  createdAt     DateTime @default(now())
}

model OverheadEntry {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("other")
  type      String   @default("indirect")
  amount    Float
  isActive  Boolean  @default(true)
  note      String?
  createdAt DateTime @default(now())
}

model DeliveryPartner {
  id             Int                    @id @default(autoincrement())
  name           String
  commissionType String                 @default("percentage")
  commission     Float                  @default(0)
  contractStart  String?
  contractEnd    String?
  contractNotes  String?
  isActive       Boolean                @default(true)
  createdAt      DateTime               @default(now())
  prices         DeliveryProductPrice[]
}

model DeliveryProductPrice {
  id        Int             @id @default(autoincrement())
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId Int
  productId Int
  price     Float

  @@unique([partnerId, productId])
}

model PosOrder {
  id                Int            @id @default(autoincrement())
  orderNumber       String         @unique
  orderType         String         @default("dine_in")
  tableId           Int?
  customerId        Int?
  customer          Customer?      @relation(fields: [customerId], references: [id])
  deliveryPartnerId Int?
  commissionAmount  Float          @default(0)
  paymentMethod     String         @default("cash")
  subtotal          Float
  discountType      String?
  discountValue     Float          @default(0)
  discountAmount    Float          @default(0)
  total             Float
  note              String?
  status            String         @default("completed")
  createdAt         DateTime       @default(now())
  items             PosOrderItem[]
}

model PosOrderItem {
  id          Int      @id @default(autoincrement())
  order       PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     Int
  productId   Int
  productName String
  quantity    Float
  unitPrice   Float
  total       Float
}

model ChartOfAccount {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  name       String
  type       String   // asset | liability | equity | revenue | expense
  subType    String?
  parentCode String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
}

model BankAccount {
  id                Int               @id @default(autoincrement())
  name              String
  type              String            @default("bank") // bank | custody | cash
  bankName          String?
  accountNumber     String?
  balance           Float             @default(0)
  currency          String            @default("EGP")
  linkedAccountCode String?           // رابط بدليل الحسابات
  notes             String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  transactions      BankTransaction[]
}

model BankTransaction {
  id                Int           @id @default(autoincrement())
  bankAccount       BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bankAccountId     Int
  date              DateTime
  type              String        // debit | credit
  amount            Float
  description       String
  contraAccountCode String?       // الحساب المقابل في القيد
  reference         String?
  notes             String?
  journalEntryId    Int?          @unique
  journalEntry      JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt         DateTime      @default(now())
}

model JournalEntry {
  id              Int                @id @default(autoincrement())
  entryNumber     String             @unique
  date            DateTime
  description     String
  reference       String?
  isAutomatic     Boolean            @default(false)
  createdAt       DateTime           @default(now())
  lines           JournalEntryLine[]
  bankTransaction BankTransaction?
}

model JournalEntryLine {
  id             Int          @id @default(autoincrement())
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  journalEntryId Int
  accountCode    String
  accountName    String?
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
}
